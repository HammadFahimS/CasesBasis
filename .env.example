# ── LLM Provider ──────────────────────────────────────────────────────────────
LLM_PROVIDER=groq          # groq | together | openai | anthropic | vllm

# ── Inference APIs ─────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.2-11B-Vision-Instruct-Turbo

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-2024-08-06

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Self-hosted vLLM (Vast.ai) ─────────────────────────────────────────────────
VLLM_BASE_URL=https://<instance-id>.vast.ai:8000/v1
VLLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# ── HuggingFace ────────────────────────────────────────────────────────────────
HUGGINGFACE_TOKEN=         # Required for gated models (Llama etc.)

# ── LangSmith Tracing ──────────────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=

# ── FalkorDB (local Docker) ────────────────────────────────────────────────────
FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# ── Persistence ────────────────────────────────────────────────────────────────
DB_PATH=casesbasis.db

# ── Auth ───────────────────────────────────────────────────────────────────────
APP_SECRET=change-me-in-production
MAGIC_LINK_TTL_MINUTES=15
