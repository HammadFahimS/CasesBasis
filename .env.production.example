# ─────────────────────────────────────────────────────────────────────────────
# Production environment template for CasesBasis.
#
# Copy this to `.env.production` ON THE SERVER and fill in the real values.
# `.env.production` is git-ignored and must NEVER be committed. docker-compose
# .prod.yml loads it into the app + cloudflared containers.
#
# Generate APP_SECRET with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# ─────────────────────────────────────────────────────────────────────────────

# ── Core (required) ──────────────────────────────────────────────────────────
ENV=production
APP_SECRET=                      # REQUIRED in production (session cookie signing)
LLM_PROVIDER=cerebras

# ── Cerebras (the live + manual sim LLM) — required ──────────────────────────
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gemma-4-31b        # live voice sim default (fast); gpt-oss-120b is pinned in code for manual/ECG/labs

# ── ElevenLabs TTS/STT — required for the voice sim ──────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_NURSE_VOICE_ID=
ELEVENLABS_PATIENT_VOICE_ID=
ELEVENLABS_EMS_VOICE_ID=
ELEVENLABS_FAMILY_VOICE_ID=
ELEVENLABS_RT_VOICE_ID=
ELEVENLABS_CONSULT_VOICE_ID=
# TTS model for every live line. Blank = eleven_v4_turbo (expressive, audio tags).
# Rollback without a deploy: eleven_flash_v2_5 (no tags) or eleven_v3.
ELEVENLABS_TTS_MODEL=

# ── Speech-to-text (if used) ─────────────────────────────────────────────────
DEEPGRAM_API_KEY=

# ── Cloudflare Tunnel — required to be reachable at casesbasis.com ────────────
# Create a tunnel in the Cloudflare Zero Trust dashboard (Networks -> Tunnels),
# route casesbasis.com -> http://app:8000, and paste the tunnel token here.
TUNNEL_TOKEN=

# ── Knowledge graph (FalkorDB) — set by compose; leave as-is ─────────────────
FALKORDB_HOST=falkordb
FALKORDB_PORT=6379
EMBEDDING_DIM=384

# ── Live voice runtime (autonomous clock) ────────────────────────────────────
LIVE_RUNTIME=1
LIVE_RUNTIME_TICK_SECONDS=5

# ── Optional: LangSmith tracing ──────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=casesbasis-prod

# ── Optional: other providers (unused when LLM_PROVIDER=cerebras) ────────────
GROQ_API_KEY=
TOGETHER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_TOKEN=

# CORS is locked to the domain by docker-compose.prod.yml (ALLOWED_ORIGINS).
